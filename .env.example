# Copy to .env and fill in. Keep this file private.
API_KEY=                       # random, 32+ chars (e.g. openssl rand -hex 32)
WALLET_RPC_URL=http://127.0.0.1:19091   # wallet-rpc MUST be reachable from localhost only
WEBHOOK_URL=                   # your shop's endpoint (optional)
WEBHOOK_SECRET=                # random, used to HMAC-sign webhooks
CONFIRMATIONS=10
INVOICE_TTL_MIN=60
RETENTION_HOURS=24             # finished invoices are deleted after this
ATOMIC_UNITS=1000000000        # atomic units per BDX; VERIFY against Beldex docs
HOST=127.0.0.1                 # put a TLS reverse proxy / Tor onion service in front
PORT=8080
